{
	"key": "group_rgeometry_services",
	"title": "Services",
	"description": "The 3-column \"What We Do\" section. Each service has a title, description, and an icon picked from the built-in set.",
	"fields": [
		{ "key": "field_rg_services_eyebrow", "label": "Eyebrow label", "name": "services_eyebrow", "type": "text", "default_value": "What We Do", "instructions": "Small uppercase label above the heading." },
		{ "key": "field_rg_services_heading", "label": "Heading", "name": "services_heading", "type": "text", "default_value": "Three things, done well." },
		{
			"key": "field_rg_services_items",
			"label": "Services",
			"name": "services_items",
			"type": "repeater",
			"layout": "block",
			"button_label": "Add service",
			"collapsed": "field_rg_service_title",
			"min": 0,
			"sub_fields": [
				{ "key": "field_rg_service_title",       "label": "Title",       "name": "title",       "type": "text" },
				{ "key": "field_rg_service_description", "label": "Description", "name": "description", "type": "textarea", "rows": 3, "new_lines": "" },
				{
					"key": "field_rg_service_icon",
					"label": "Icon",
					"name": "icon",
					"type": "rg_icon_picker",
					"return_format": "value",
					"instructions": "Click to choose from the icon library."
				}
			]
		}
	],
	"location": [[{ "param": "page_type", "operator": "==", "value": "front_page" }]],
	"menu_order": 3,
	"position": "normal",
	"label_placement": "top",
	"instruction_placement": "label",
	"active": true
}
