{
	"key": "group_rgeometry_footer",
	"title": "Footer",
	"description": "The site footer at the bottom of the page. Brand, tagline, nav links, social icons, and the copyright line.",
	"fields": [
		{ "key": "field_rg_footer_brand",   "label": "Brand",   "name": "footer_brand",   "type": "text", "default_value": "RGeometry" },
		{ "key": "field_rg_footer_tagline", "label": "Tagline", "name": "footer_tagline", "type": "text", "default_value": "Architecture grounded in how you live." },
		{
			"key": "field_rg_footer_links",
			"label": "Footer links",
			"name": "footer_links",
			"type": "repeater",
			"layout": "table",
			"button_label": "Add link",
			"collapsed": "field_rg_footer_link_label",
			"min": 0,
			"sub_fields": [
				{ "key": "field_rg_footer_link_label", "label": "Label", "name": "label", "type": "text" },
				{
					"key": "field_rg_footer_link_target",
					"label": "Scrolls to",
					"name": "target",
					"type": "select",
					"choices": { "projects": "Projects", "services": "Services", "about": "About", "process": "Process", "testimonials": "Testimonials", "contact": "Contact" },
					"return_format": "value",
					"allow_null": 0
				}
			]
		},
		{
			"key": "field_rg_footer_socials",
			"label": "Social links",
			"name": "footer_socials",
			"type": "repeater",
			"layout": "block",
			"button_label": "Add social",
			"collapsed": "field_rg_footer_social_icon",
			"min": 0,
			"sub_fields": [
				{
					"key": "field_rg_footer_social_icon",
					"label": "Icon",
					"name": "icon",
					"type": "select",
					"choices": { "instagram": "Instagram", "linkedin": "LinkedIn" },
					"default_value": "instagram",
					"return_format": "value",
					"allow_null": 0
				},
				{ "key": "field_rg_footer_social_url",   "label": "Profile URL",   "name": "url",   "type": "url" },
				{ "key": "field_rg_footer_social_label", "label": "Screen-reader label", "name": "label", "type": "text", "instructions": "Read aloud by screen readers. e.g. \"Follow us on Instagram\"." }
			]
		},
		{ "key": "field_rg_footer_copyright", "label": "Copyright suffix", "name": "footer_copyright", "type": "text", "default_value": "All rights reserved.", "instructions": "Appended after the auto-generated year and brand." }
	],
	"location": [[{ "param": "page_type", "operator": "==", "value": "front_page" }]],
	"menu_order": 9,
	"position": "normal",
	"label_placement": "top",
	"instruction_placement": "label",
	"active": true
}
